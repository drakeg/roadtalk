{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Keep Python on versions below 3.15 until the backend stack is validated there",
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "Keep React Native aligned with Expo SDK 57",
      "matchPackageNames": [
        "react-native"
      ],
      "allowedVersions": "<0.87.0"
    }
  ]
}
